# Copy this file to db.properties and configure local credentials.
db.host=localhost
db.port=3306
db.name=erp_little_horizons
db.user=erp_app
db.password=CHANGE_ME

# Secure defaults. Set db.ssl=false only on an isolated local MySQL instance
# that does not provide TLS certificates.
db.ssl=true
db.verifyServerCertificate=true
db.allowPublicKeyRetrieval=false
db.poolSize=10

# Optional local first-run administrator. Keep this file untracked and private.
# app.initialAdminUsername=admin
# app.initialAdminPassword=REPLACE_WITH_A_PRIVATE_PASSWORD_OF_12_CHARACTERS_OR_MORE
